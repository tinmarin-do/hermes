{
  "permissions": {
    "allow": [
      "Bash(uv:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(python:*)",
      "Bash(pytest:*)",
      "Bash(terraform plan:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git merge:*)",
      "Bash(direnv allow)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)"
    ],
    "ask": [
      "Bash(gcloud:*)",
      "Bash(gsutil:*)",
      "Bash(bq:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)"
    ],
    "deny": [
      "Bash(gcloud secrets versions access:*)",
      "Bash(gcloud secrets versions add:*)",
      "Bash(rm -rf:*)",
      "Bash(curl * | bash:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/tea/hermes/scripts/hook-pre-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash(terraform apply:*)",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/tea/hermes/scripts/hook-post-terraform.sh"
          }
        ]
      }
    ]
  }
}
