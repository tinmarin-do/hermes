# Hermes — .env.example
# Copiar a .env y completar valores. NUNCA commitear .env.
# Espeja la estructura de Secret Manager para cloud mode.

HERMES_MODE=local

# GCP (solo cloud mode)
GCP_PROJECT_ID=hermes-<tu-id>
GCP_REGION=us-central1
TF_STATE_BUCKET=hermes-tfstate-<tu-id>

# Database
# local: DuckDB (automático, no requiere config)
# cloud: Cloud SQL
DATABASE_URL=postgresql://hermes:password@/hermes?host=/cloudsql/<project>:<region>:<instance>

# LLM — cloud mode
DEEPSEEK_API_KEY=sk-...
OPENAI_API_KEY=

# LLM — local mode (Ollama, defaults en .envrc)
# OLLAMA_MODEL_ANALYST=llama3.2:3b
# OLLAMA_MODEL_PM=llama3.1:8b

# Exchange — Binance testnet (nunca keys con permiso de retiro)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Exchange — Binance live (solo Semana 4+, solo-trade sin retiro)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Guardrails
HERMES_CAPITAL_USD=500
HERMES_ALLOWED_SYMBOLS=BTC/USDT,ETH/USDT
HERMES_MAX_POSITIONS=2
HERMES_DAILY_LOSS_LIMIT_PCT=0.02
