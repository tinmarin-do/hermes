# Hermes — .env.example
# Copiar a .env y completar valores. NUNCA commitear .env.
# Espeja la estructura de Secret Manager para cloud mode.

HERMES_MODE=cloud

# GCP (solo cloud mode)
GCP_PROJECT_ID=hermes-<tu-id>
GCP_REGION=us-central1
TF_STATE_BUCKET=hermes-tfstate-<tu-id>

# Database
# local: DuckDB (automático, no requiere config)
# cloud: Cloud SQL
DATABASE_URL=postgresql://hermes:password@/hermes?host=/cloudsql/<project>:<region>:<instance>

# LLM — DeepSeek V4 Flash (unificado)
DEEPSEEK_API_KEY=sk-...
OPENAI_API_KEY=

# Exchange de EJECUCIÓN — Bitso (decidido 2026-07-03; spot-only → live long-only)
# La key NUNCA con permiso de retiro (PRD §8.3). La DATA sigue viniendo de Binance (público).
BITSO_API_KEY=
BITSO_API_SECRET=

# Exchange — Binance (solo DATA pública; keys legacy opcionales)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Guardrails (PRD v0.3 §8.2 — capital de trading cloud = $50, bolsillo distinto del cap operativo)
HERMES_CAPITAL_USD=50
HERMES_ALLOWED_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,LINK/USDT,AVAX/USDT,XRP/USDT
HERMES_MAX_POSITIONS=6
HERMES_DAILY_LOSS_LIMIT_PCT=0.02
# Kelly interim; el definitivo sale de /brain:calibrate-risk sobre la señal momentum
HERMES_KELLY_FRACTION=0.10
