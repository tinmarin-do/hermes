{
  "namespace": "data",
  "medallion_layers": ["bronze", "silver", "gold"],
  "tools": {
    "data.ingest-bronze": {
      "description": "Pull raw OHLCV from ccxt for ONE symbol+timeframe+range",
      "args": {
        "required": ["symbol", "timeframe"],
        "properties": {
          "symbol": { "type": "string", "example": "BTC/USDT" },
          "timeframe": { "type": "string", "enum": ["1m","5m","15m","1h","4h","1d"] },
          "since": { "type": "string", "format": "date", "nullable": true },
          "until": { "type": "string", "format": "date", "nullable": true }
        }
      },
      "output_schema": "MarketData (Bronze)",
      "side_effects": "Writes to bronze_ohlcv table"
    },
    "data.validate-bronze": {
      "description": "Validate Bronze layer integrity for ONE symbol",
      "args": { "required": ["symbol", "timeframe"] },
      "output_schema": { "valid": "boolean", "issues": "string[]" },
      "side_effects": "none"
    },
    "data.transform-silver": {
      "description": "Clean + compute regime features (Hurst, GARCH, spread) for ONE symbol",
      "args": { "required": ["symbol", "timeframe"] },
      "output_schema": "RegimeFeatures (Silver)",
      "side_effects": "Writes to silver_features table"
    },
    "data.validate-silver": {
      "description": "Validate Silver layer (Hurst in range, GARCH > 0, no NaN)",
      "args": { "required": ["symbol", "timeframe"] },
      "output_schema": { "valid": "boolean", "regime_distribution": "object" },
      "side_effects": "none"
    },
    "data.aggregate-gold": {
      "description": "Classify regime + produce final signals ready for agents",
      "args": {
        "properties": {
          "symbols": { "type": "array", "items": { "type": "string" }, "nullable": true }
        }
      },
      "output_schema": "RegimeSignal (Gold)",
      "side_effects": "Writes to gold_signals table"
    },
    "data.validate-gold": {
      "description": "Validate Gold snapshot completeness and freshness (< 2h)",
      "args": {},
      "output_schema": { "valid": "boolean", "symbols": "object" },
      "side_effects": "none"
    },
    "data.backfill": {
      "description": "Orchestrate ingest-bronze + transform-silver for a historical range",
      "args": {
        "required": ["symbol", "timeframe", "since", "until"]
      },
      "composed_of": ["data.ingest-bronze", "data.validate-bronze", "data.transform-silver", "data.validate-silver"],
      "side_effects": "Writes to bronze_ohlcv and silver_features tables"
    }
  }
}
