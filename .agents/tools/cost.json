{
  "namespace": "cost",
  "tools": {
    "cost.quote": {
      "description": "Estimate cost of one operation without executing it",
      "args": {
        "type": "object",
        "required": ["resource_type", "description"],
        "properties": {
          "resource_type": { "type": "string", "enum": ["gcp", "llm"] },
          "description": { "type": "string" }
        }
      },
      "response_data": {
        "estimated_usd": "number",
        "assumptions": "string[]",
        "free_tier": "boolean"
      },
      "side_effects": "none"
    },
    "cost.gate": {
      "description": "Show quote + budget status, request explicit user authorization",
      "args": {
        "type": "object",
        "required": ["resource_type", "description"],
        "properties": {
          "resource_type": { "type": "string", "enum": ["gcp", "llm"] },
          "description": { "type": "string" }
        }
      },
      "response_data": {
        "authorized": "boolean",
        "estimated_usd": "number",
        "accumulated_usd": "number",
        "remaining_usd": "number"
      },
      "on_status_blocked": "Cap exceeded. Human intervention required."
    },
    "cost.log": {
      "description": "Append one authorized entry to the cost ledger. Only call after cost.gate authorized.",
      "args": {
        "type": "object",
        "required": ["resource_type", "date", "description", "cost_usd", "authorized_by"],
        "properties": {
          "resource_type": { "type": "string", "enum": ["gcp", "llm"] },
          "date": { "type": "string", "format": "date" },
          "description": { "type": "string" },
          "cost_usd": { "type": "number" },
          "authorized_by": { "type": "string" }
        }
      },
      "side_effects": "Appends row to docs/cost_ledger_*.md"
    },
    "cost.status": {
      "description": "Show current spend vs caps for GCP and LLM",
      "args": {},
      "side_effects": "none"
    },
    "cost.reset-llm": {
      "description": "Close monthly LLM ledger and start new cycle",
      "args": {
        "type": "object",
        "required": ["month"],
        "properties": {
          "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" }
        }
      },
      "side_effects": "Modifies docs/cost_ledger_llm.md"
    }
  }
}
